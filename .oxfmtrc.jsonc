// oxfmt configuration. JSONC, not JSON, on purpose: the ignore list below carries
// reasons that must survive, and oxfmt auto-discovers `.oxfmtrc.jsonc` exactly as it
// does `.oxfmtrc.json` (verified — dropping the file raises the considered set from
// 585 files to 634). Keeping the patterns here rather than in a separate ignore file
// means no `--ignore-path` flag and nothing named after a formatter this repo no
// longer uses.
//
// Per-line suppressions in the source are spelled `// prettier-ignore`, and they stay
// that way. oxfmt honours that directive as well as its own `// oxfmt-ignore` — verified
// both ways against a deliberately misformatted array, with a plain `// hello` comment as
// the control to prove it is the directive doing the work and not merely a preceding
// comment. Renaming the existing ones would be pure churn across `src/gen/table/`,
// `src/script/verify/`, and two test files, and deleting one silently reflows a line that
// is laid out by hand on purpose.
//
// The ignore list is a safety net, not the definition of what gets formatted:
// `format:run` in package.json still hands oxfmt an explicit list of globs rather
// than the bare `oxfmt` that would suffice. Bare, oxfmt considers 585 files against
// the ~500 the explicit list covers — it reaches markdown, css, html and `.vue`
// single-file components, none of which this repo formats. A silently *wider*
// set is how a tool-written file gets clobbered, so the list stays explicit and the
// two defences overlap on purpose.
//
// The root tsconfigs are named one by one in that list for a reason that is easy to undo:
// **oxfmt matches `tsconfig*.json` at any depth**, not just at the root, so the obvious
// shorthand also pulls in every workspace's own `tsconfig*.json` — files this repo
// deliberately does not format. That was caught only by `format:check` failing on three
// files nobody had touched. Do not re-collapse them.
{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 120,
	"semi": false,
	"singleQuote": true,
	"trailingComma": "es5",
	"useTabs": true,
	// Must stay false. `package.json` has a deliberate key order — the `exports` map is
	// ordered by public surface and the scripts are grouped by concern — and sorting it
	// would produce a large, meaningless diff that destroys both groupings.
	"sortPackageJson": false,
	// **`types/` is not in this list, and must not come back.** These patterns are
	// unanchored, and gitignore semantics match an unanchored directory name at *any* depth
	// — so `types/` never meant the root build directory `.gitignore` names as `/types/`. It
	// meant `src/types/`: the library's entire public type surface, seventeen files that
	// `format:run`'s own `"src/**/*.ts"` glob advertises covering and that the formatter had
	// never once read. Four had drifted, one of them past `printWidth`.
	//
	// This is the same hazard the header records for `tsconfig*.json`, in the opposite
	// direction — there a pattern reached workspaces it should not, here it reached a source
	// tree it should not. Anchor a build-output pattern (`/types/`) or name it precisely; an
	// unanchored directory name will collide with a source directory eventually, and it does
	// so silently, because an ignored file is exactly as quiet as a well-formatted one.
	//
	// The rest of that group went with it, for the milder reason that none of them names
	// anything: `.docusaurus/` and `static/` are a site generator this repo replaced with
	// VitePress, and `libs/`, `build/` and `src/bld/` match no directory at any depth. A
	// speculative ignore is not free even when it is inert — it is indistinguishable from a
	// load-bearing one, which is how `types/` survived every reading of this list. Add a
	// pattern when something writes the path, not in case something might.
	"ignorePatterns": [
		"node_modules/",
		"dist/",
		"coverage/",
		".tmp/",
		// `docs/**`, not `docs/`: gitignore semantics mean a file under a *directory*
		// pattern can never be re-included by a later negation, and the two hand-authored
		// configs below must be reachable by the formatter.
		"docs/**",
		"!docs/tsconfig.json",
		// Re-including a file also means re-including every directory above it: an
		// ignored *directory* is never descended into, so `!docs/.vitepress/config.mts`
		// alone has no effect while `docs/**` still excludes `docs/.vitepress`.
		"!docs/.vitepress",
		"docs/.vitepress/**",
		"!docs/.vitepress/config.mts",
		// The theme entry point is a hand-written re-export of `www/theme`, so it is formatted
		// like the rest of the site's source. Same two-step as above: the directory has to be
		// re-included before a file inside it can be.
		"!docs/.vitepress/theme",
		"docs/.vitepress/theme/**",
		"!docs/.vitepress/theme/index.ts",
		// docs/docs.json stays ignored on purpose: it is tool-written, not hand-written.
		// `scripts/docs-new.mjs` rewrites it with `JSON.stringify(config, null, 2)` and
		// `scripts/docs-init.mjs`'s scaffold template is 2-space too, so formatting it to
		// this repo's tabs would make `format:check` fail after every `pnpm run docs:new`.
		// Changing that means changing both writers to `'\t'` in the same commit.
		// (Covered by `docs/**` above; spelled out here so the reason survives.)
		//
		// Generated by scripts/gen-inspect-snapshot.mjs, which formats it one element per
		// line on purpose: a changed element is then one changed line in `git diff`.
		// A formatter expands it to ~25k lines and turns any change into an unreadable wall.
		"test/read/fixtures/inspect-surface.snapshot.json",
		"package-lock.json",
		"pnpm-lock.yaml",
		"**/*.min.js",
		"demos/**/package-lock.json",
		"demos/**/node_modules/",
		"tools/ooxml-validator/bin/",
	],
}
