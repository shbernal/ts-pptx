{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "ts-pptx scripts and root build configs",
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"types": ["node"],
		"allowJs": true,
		"checkJs": true,
		"allowImportingTsExtensions": true,
		"incremental": true,
		"tsBuildInfoFile": ".tmp/tsconfig.scripts.tsbuildinfo",
		// The build/maintenance scripts are plain untyped ESM. Relax the two
		// annotation-demanding rules (implicit `any` params/vars, index-signature
		// property access) that only make sense for annotated `.ts` sources, and
		// keep the checks that catch real defects: strict null-safety, argument
		// assignability, and property existence.
		"noImplicitAny": false,
		"noPropertyAccessFromIndexSignature": false,
		// Scoped to this project, deliberately not to tsconfig.base.json. Pulling
		// `tsdown.config.ts` into a typechecked project also pulls in tsdown's own
		// shipped `.d.mts`, which references optional peer packages we do not
		// install (`@volar/typescript`, `@tsdown/exe`, `unplugin-unused`, …) and so
		// cannot resolve. Those are unfixable from here and say nothing about this
		// repo's code. The library project (tsconfig.json) keeps full lib checking.
		"skipLibCheck": true
	},
	// The root build configs are included here rather than in tsconfig.json: they
	// are Node-side tooling, not shipped library code, and they were previously in
	// no project's `include` at all — never typechecked by anything.
	"include": [
		"scripts/**/*.mjs",
		"vitest.config.ts",
		"tsdown.config.ts",
		"tsdown.dev.config.ts",
		"playwright.config.ts"
	]
}
