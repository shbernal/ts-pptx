{
	"name": "@shbernal/ts-pptx",
	"version": "3.2.0",
	"author": {
		"name": "shbernal",
		"url": "https://github.com/shbernal/"
	},
	"description": "Create PowerPoint presentations (.pptx) from TypeScript and modern JavaScript",
	"homepage": "https://github.com/shbernal/ts-pptx#readme",
	"license": "MIT",
	"packageManager": "pnpm@11.3.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"sideEffects": false,
	"exports": {
		".": {
			"browser": {
				"types": "./dist/browser.d.ts",
				"default": "./dist/browser.js"
			},
			"node": {
				"types": "./dist/node.d.ts",
				"default": "./dist/node.js"
			},
			"default": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./inspect": {
			"types": "./dist/inspect.d.ts",
			"default": "./dist/inspect.js"
		},
		"./measure": {
			"types": "./dist/measure.d.ts",
			"default": "./dist/measure.js"
		},
		"./read": {
			"types": "./dist/read.d.ts",
			"default": "./dist/read.js"
		},
		"./script": {
			"types": "./dist/script.d.ts",
			"default": "./dist/script.js"
		},
		"./math": {
			"types": "./dist/math.d.ts",
			"default": "./dist/math.js"
		},
		"./zip": {
			"types": "./dist/zip.d.ts",
			"default": "./dist/zip.js"
		},
		"./html": {
			"types": "./dist/html.d.ts",
			"default": "./dist/html.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"node": "./dist/node.js",
			"default": "./dist/node.js"
		},
		"./browser": {
			"types": "./dist/browser.d.ts",
			"browser": "./dist/browser.js",
			"default": "./dist/browser.js"
		},
		"./package.json": {
			"default": "./package.json"
		}
	},
	"files": [
		"dist",
		"skills"
	],
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsdown",
		"build:dev": "tsdown --config tsdown.dev.config.ts",
		"prepare": "node scripts/install-hooks.mjs && node scripts/ensure-dist.mjs --if-missing",
		"start": "pnpm run watch",
		"watch": "tsdown --watch",
		"watch:dev": "tsdown --config tsdown.dev.config.ts --watch",
		"ensure-dist": "node scripts/ensure-dist.mjs",
		"verify": "node scripts/run-steps.mjs ensure-dist typecheck typecheck:scripts typecheck:test typecheck:site raw-xml:check path-refs:check docs:check test",
		"verify:full": "node scripts/run-steps.mjs verify docs:build script:roundtrip:all package:lint test:package bundle-size:check",
		"check:static": "node scripts/run-steps.mjs ensure-dist lint format:check typecheck typecheck:scripts typecheck:test typecheck:site raw-xml:check path-refs:check docs:check",
		"check:package": "node scripts/run-steps.mjs ensure-dist package:lint test:package bundle-size:check",
		"test": "pnpm run ensure-dist && vitest run",
		"test:unit": "pnpm run ensure-dist && vitest run test/regression",
		"test:schema": "pnpm run ensure-dist && vitest run test/schema-validation.test.js",
		"schema:versions": "pnpm run ensure-dist && node scripts/ooxml-version-probe.mjs",
		"test:read": "pnpm run ensure-dist && vitest run test/read",
		"test:read:emit": "pnpm run ensure-dist && node scripts/read-emit-roundtrip.mjs",
		"test:read:emit:edits": "pnpm run ensure-dist && node scripts/read-emit-edits.mjs",
		"read:census": "pnpm run ensure-dist && node scripts/read-blindness-census.mjs",
		"read:append-ceiling": "pnpm run ensure-dist && node scripts/append-ceiling.mjs",
		"script:roundtrip": "pnpm run ensure-dist && node scripts/script-roundtrip.mjs",
		"script:roundtrip:a": "pnpm run ensure-dist && node scripts/script-roundtrip.mjs --tier a",
		"script:roundtrip:all": "pnpm run script:roundtrip && pnpm run script:roundtrip:a",
		"script:census": "pnpm run ensure-dist && node scripts/note-census.mjs",
		"test:watch": "vitest --watch test/regression",
		"test:coverage": "pnpm run ensure-dist && vitest run --coverage",
		"coverage:probe": "pnpm run ensure-dist && vitest run --coverage --coverage.reportsDirectory=coverage/probe --coverage.reporter=json --coverage.reporter=json-summary --coverage.reporter=text-summary --coverage.thresholds.statements=0 --coverage.thresholds.branches=0 --coverage.thresholds.functions=0 --coverage.thresholds.lines=0",
		"coverage:merge": "node scripts/coverage-merge.mjs",
		"coverage:gate": "pnpm run coverage:merge && node scripts/coverage-gate.mjs",
		"test:package": "node scripts/package-smoke.mjs",
		"test:browser": "pnpm run docs:build && playwright test",
		"demos:build": "pnpm run ensure-dist && pnpm --dir demos/showcases run build",
		"test:com": "pnpm run ensure-dist && node scripts/powerpoint-com-smoke.mjs",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
		"typecheck:test": "tsc -p tsconfig.test.json --noEmit",
		"typecheck:site": "tsc -p docs/tsconfig.json --noEmit",
		"lint": "oxlint .",
		"lint:fix": "pnpm run lint --fix",
		"format:run": "oxfmt \"src/**/*.ts\" package.json tools/api-docs/package.json .oxfmtrc.jsonc pnpm-workspace.yaml typedoc.docs.json tsconfig.base.json tsconfig.json tsconfig.scripts.json tsconfig.test.json docs/tsconfig.json docs/.vitepress/config.mts \"docs/.vitepress/theme/**/*.ts\" \"www/**/*.ts\" .oxlintrc.jsonc tsdown.config.ts tsdown.dev.config.ts vitest.config.ts playwright.config.ts \"scripts/**/*.mjs\" \"test/**/*.mjs\" \"test/**/*.js\" \".github/**/*.yml\"",
		"format": "pnpm run format:run --write",
		"format:check": "pnpm run format:run --check",
		"package:lint": "node scripts/package-lint.mjs",
		"bundle-size:check": "pnpm run ensure-dist && node scripts/bundle-size-ratchet.mjs",
		"bundle-size:freeze": "pnpm run ensure-dist && node scripts/bundle-size-ratchet.mjs --freeze",
		"bundle-size:list": "pnpm run ensure-dist && node scripts/bundle-size-ratchet.mjs --list",
		"raw-xml:check": "node scripts/raw-xml-ratchet.mjs",
		"raw-xml:freeze": "node scripts/raw-xml-ratchet.mjs --freeze",
		"raw-xml:list": "node scripts/raw-xml-ratchet.mjs --list",
		"path-refs:check": "node scripts/path-refs.mjs",
		"path-refs:list": "node scripts/path-refs.mjs --list",
		"byte-identity:baseline": "node scripts/byte-identity.mjs baseline",
		"byte-identity:check": "node scripts/byte-identity.mjs check",
		"prepack": "pnpm run build",
		"version": "node scripts/sync-version.mjs --stage",
		"version:sync": "node scripts/sync-version.mjs",
		"version:check": "node scripts/sync-version.mjs --check",
		"check-validator": "node tools/ooxml-validator/check-updates.js",
		"docs:init": "node scripts/docs-init.mjs",
		"docs:list": "node scripts/docs-list.mjs",
		"docs:new": "node scripts/docs-new.mjs",
		"docs:api": "node scripts/docs-api.mjs",
		"docs:llms": "node scripts/generate-llms-docs.mjs",
		"docs:index": "node scripts/docs-index.mjs",
		"docs:check": "pnpm run docs:api && node scripts/docs-check.mjs",
		"docs:prepare": "pnpm run docs:api && pnpm run docs:llms && pnpm run docs:index",
		"docs:dev": "pnpm run ensure-dist && pnpm run docs:prepare && vitepress dev docs",
		"docs:build": "pnpm run ensure-dist && pnpm run docs:prepare && node scripts/docs-check.mjs && vitepress build docs && node scripts/docs-check.mjs --dist",
		"docs:preview": "vitepress preview docs"
	},
	"dependencies": {
		"@xmldom/xmldom": "^0.9.10",
		"fflate": "^0.8.3",
		"opentype.js": "^2.0.0"
	},
	"peerDependencies": {
		"mathml2omml": "^0.5.0",
		"temml": "^0.13.3"
	},
	"peerDependenciesMeta": {
		"mathml2omml": {
			"optional": true
		},
		"temml": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@playwright/test": "^1.62.1",
		"@types/node": "^26.1.1",
		"@types/opentype.js": "^1.3.10",
		"@vitest/coverage-v8": "^4.1.10",
		"ast-v8-to-istanbul": "^1.0.5",
		"esbuild": "^0.28.1",
		"fast-xml-parser": "^5.10.1",
		"happy-dom": "^20.11.1",
		"istanbul-lib-coverage": "^3.2.2",
		"istanbul-lib-report": "^3.0.1",
		"istanbul-reports": "^3.2.0",
		"jszip": "^3.10.1",
		"lefthook": "^2.1.10",
		"mathml2omml": "^0.5.0",
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0",
		"oxlint-tsgolint": "7.0.2001",
		"pptx-html": "^0.1.1",
		"publint": "^0.3.21",
		"temml": "^0.13.3",
		"ts-pptx-demos-showcases": "workspace:*",
		"tsdown": "^0.22.9",
		"typescript": "^7.0.2",
		"typescript-6": "npm:typescript@6.0.3",
		"vitepress": "^1.6.4",
		"vitest": "^4.1.10",
		"vue": "^3.5.41"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shbernal/ts-pptx.git"
	},
	"keywords": [
		"pptx",
		"ooxml",
		"powerpoint",
		"presentation",
		"slides",
		"typescript",
		"charts",
		"html"
	],
	"bugs": {
		"url": "https://github.com/shbernal/ts-pptx/issues"
	}
}
