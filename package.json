{
	"name": "@shbernal/ts-pptx",
	"version": "1.0.0",
	"author": {
		"name": "shbernal",
		"url": "https://github.com/shbernal/"
	},
	"description": "Create PowerPoint presentations (.pptx) from TypeScript and modern JavaScript",
	"homepage": "https://github.com/shbernal/ts-pptx#readme",
	"license": "MIT",
	"packageManager": "pnpm@11.3.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"browser": "./dist/browser.js",
			"node": "./dist/node.js",
			"default": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/core.d.ts",
			"default": "./dist/core.js"
		},
		"./inspect": {
			"types": "./dist/inspect.d.ts",
			"default": "./dist/inspect.js"
		},
		"./measure": {
			"types": "./dist/measure.d.ts",
			"default": "./dist/measure.js"
		},
		"./read": {
			"types": "./dist/read.d.ts",
			"default": "./dist/read.js"
		},
		"./math": {
			"types": "./dist/math.d.ts",
			"default": "./dist/math.js"
		},
		"./zip": {
			"types": "./dist/zip.d.ts",
			"default": "./dist/zip.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"node": "./dist/node.js",
			"default": "./dist/node.js"
		},
		"./browser": {
			"types": "./dist/browser.d.ts",
			"browser": "./dist/browser.js",
			"default": "./dist/browser.js"
		},
		"./standalone": {
			"types": "./dist/standalone.d.ts",
			"browser": "./dist/standalone.js",
			"default": "./dist/standalone.js"
		},
		"./package.json": {
			"default": "./package.json"
		}
	},
	"files": [
		"dist"
	],
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsdown",
		"build:dev": "tsdown --config tsdown.dev.config.ts",
		"prepare": "lefthook install",
		"start": "pnpm run watch",
		"watch": "tsdown --watch",
		"watch:dev": "tsdown --config tsdown.dev.config.ts --watch",
		"test": "pnpm run build && vitest run test/regression test/schema-validation.test.mjs test/read test/backlog-ledger.test.mjs",
		"test:unit": "pnpm run build && vitest run test/regression",
		"test:schema": "pnpm run build && vitest run test/schema-validation.test.mjs",
		"test:read": "pnpm run build && vitest run test/read",
		"test:read:emit": "pnpm run build && node scripts/read-emit-roundtrip.mjs",
		"test:read:emit:edits": "pnpm run build && node scripts/read-emit-edits.mjs",
		"test:watch": "pnpm run build:dev && vitest --watch test/regression",
		"test:watch:fast": "vitest --watch test/regression",
		"test:coverage": "pnpm run build && vitest run --coverage test/regression test/schema-validation.test.mjs test/read test/backlog-ledger.test.mjs",
		"test:package": "node scripts/package-smoke.mjs",
		"test:demo:node": "node scripts/demo-smoke.mjs node",
		"test:demo:vite": "node scripts/demo-smoke.mjs vite",
		"test:demos": "node scripts/demo-smoke.mjs",
		"test:com": "pnpm run build && node scripts/powerpoint-com-smoke.mjs",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
		"typecheck:test": "pnpm run build && tsc -p tsconfig.test.json --noEmit",
		"lint": "eslint . --no-warn-ignored",
		"lint:fix": "pnpm run lint -- --fix",
		"format": "prettier \"src/**/*.ts\" package.json pnpm-workspace.yaml typedoc.docs.json tsconfig*.json docs/docs.json docs/tsconfig.json docs/.vitepress/config.mts eslint.config.mjs tsdown.config.ts tsdown.dev.config.ts vitest.config.ts \"scripts/**/*.mjs\" \"test/**/*.mjs\" \"test/**/*.js\" \".github/**/*.yml\" --write",
		"format:check": "prettier \"src/**/*.ts\" package.json pnpm-workspace.yaml typedoc.docs.json tsconfig*.json docs/docs.json docs/tsconfig.json docs/.vitepress/config.mts eslint.config.mjs tsdown.config.ts tsdown.dev.config.ts vitest.config.ts \"scripts/**/*.mjs\" \"test/**/*.mjs\" \"test/**/*.js\" \".github/**/*.yml\" --check",
		"package:lint": "node scripts/package-lint.mjs",
		"backlog": "node scripts/backlog-ledger.mjs",
		"backlog:list": "node scripts/backlog-ledger.mjs list",
		"backlog:validate": "node scripts/backlog-ledger.mjs validate",
		"test:tools": "vitest run test/backlog-ledger.test.mjs",
		"byte-identity:baseline": "node scripts/byte-identity.mjs baseline",
		"byte-identity:check": "node scripts/byte-identity.mjs check",
		"prepack": "pnpm run build",
		"check-validator": "node tools/ooxml-validator/check-updates.js",
		"pack:check": "pnpm pack --dry-run --json",
		"docs:init": "python3 scripts/docs-init.py",
		"docs:list": "python3 scripts/docs-list.py",
		"docs:new": "python3 scripts/docs-new.py",
		"docs:api": "node scripts/docs-api.mjs",
		"docs:llms": "node scripts/generate-llms-docs.mjs",
		"docs:index": "python3 scripts/docs-index.py",
		"docs:check": "pnpm run docs:api && python3 scripts/docs-check.py",
		"docs:prepare": "pnpm run docs:api && pnpm run docs:llms && pnpm run docs:index",
		"docs:dev": "pnpm run docs:prepare && vitepress dev docs",
		"docs:build": "pnpm run docs:prepare && python3 scripts/docs-check.py && vitepress build docs",
		"docs:preview": "vitepress preview docs"
	},
	"dependencies": {
		"@xmldom/xmldom": "^0.9.10",
		"fast-xml-parser": "^5.10.1",
		"fflate": "^0.8.3",
		"opentype.js": "^2.0.0"
	},
	"peerDependencies": {
		"mathml2omml": "^0.5.0",
		"temml": "^0.13.3"
	},
	"peerDependenciesMeta": {
		"mathml2omml": {
			"optional": true
		},
		"temml": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@arethetypeswrong/core": "^0.18.5",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.1.1",
		"@types/opentype.js": "^1.3.10",
		"@typescript-eslint/eslint-plugin": "^8.64.0",
		"@typescript-eslint/parser": "^8.64.0",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"jszip": "^3.10.1",
		"lefthook": "^2.1.10",
		"mathml2omml": "^0.5.0",
		"prettier": "^3.9.5",
		"publint": "^0.3.21",
		"temml": "^0.13.3",
		"tsdown": "^0.22.9",
		"tslib": "^2.8.1",
		"typedoc": "^0.28.20",
		"typedoc-plugin-markdown": "^4.12.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.64.0",
		"vitepress": "^1.6.4",
		"vitest": "^4.1.10",
		"yaml": "^2.9.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shbernal/ts-pptx.git"
	},
	"keywords": [
		"es6-powerpoint",
		"html-to-powerpoint",
		"javascript-create-powerpoint",
		"javascript-create-pptx",
		"javascript-generate-pptx",
		"javascript-powerpoint",
		"javascript-powerpoint-charts",
		"javascript-pptx",
		"js-create-powerpoint",
		"js-create-pptx",
		"js-generate-powerpoint",
		"js-powerpoint",
		"js-powerpoint-library",
		"js-powerpoint-pptx",
		"node-powerpoint",
		"officejs-alternative",
		"react-powerpoint",
		"slide-generator",
		"typescript-powerpoint"
	],
	"bugs": {
		"url": "https://github.com/shbernal/ts-pptx/issues"
	}
}
