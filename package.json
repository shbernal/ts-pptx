{
	"name": "@shbernal/ts-pptx",
	"version": "2.0.0",
	"author": {
		"name": "shbernal",
		"url": "https://github.com/shbernal/"
	},
	"description": "Create PowerPoint presentations (.pptx) from TypeScript and modern JavaScript",
	"homepage": "https://github.com/shbernal/ts-pptx#readme",
	"license": "MIT",
	"packageManager": "pnpm@11.3.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"sideEffects": false,
	"exports": {
		".": {
			"browser": {
				"types": "./dist/browser.d.ts",
				"default": "./dist/browser.js"
			},
			"node": {
				"types": "./dist/node.d.ts",
				"default": "./dist/node.js"
			},
			"default": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./inspect": {
			"types": "./dist/inspect.d.ts",
			"default": "./dist/inspect.js"
		},
		"./measure": {
			"types": "./dist/measure.d.ts",
			"default": "./dist/measure.js"
		},
		"./read": {
			"types": "./dist/read.d.ts",
			"default": "./dist/read.js"
		},
		"./script": {
			"types": "./dist/script.d.ts",
			"default": "./dist/script.js"
		},
		"./math": {
			"types": "./dist/math.d.ts",
			"default": "./dist/math.js"
		},
		"./zip": {
			"types": "./dist/zip.d.ts",
			"default": "./dist/zip.js"
		},
		"./html": {
			"types": "./dist/html.d.ts",
			"default": "./dist/html.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"node": "./dist/node.js",
			"default": "./dist/node.js"
		},
		"./browser": {
			"types": "./dist/browser.d.ts",
			"browser": "./dist/browser.js",
			"default": "./dist/browser.js"
		},
		"./package.json": {
			"default": "./package.json"
		}
	},
	"files": [
		"dist"
	],
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsdown",
		"build:dev": "tsdown --config tsdown.dev.config.ts",
		"prepare": "node scripts/install-hooks.mjs",
		"start": "pnpm run watch",
		"watch": "tsdown --watch",
		"watch:dev": "tsdown --config tsdown.dev.config.ts --watch",
		"ensure-dist": "node scripts/ensure-dist.mjs",
		"verify": "pnpm run ensure-dist && pnpm run typecheck && pnpm run typecheck:scripts && pnpm run typecheck:test && pnpm run backlog:validate && pnpm run raw-xml:check && vitest run",
		"verify:full": "pnpm run verify && pnpm run package:lint && pnpm run test:package && pnpm run bundle-size:check",
		"check:static": "pnpm run ensure-dist && pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run typecheck:scripts && pnpm run typecheck:test && pnpm run backlog:validate && pnpm run raw-xml:check",
		"check:package": "pnpm run ensure-dist && pnpm run package:lint && pnpm run test:package && pnpm run bundle-size:check",
		"test": "pnpm run ensure-dist && vitest run",
		"test:unit": "pnpm run ensure-dist && vitest run test/regression",
		"test:schema": "pnpm run ensure-dist && vitest run test/schema-validation.test.js",
		"schema:versions": "pnpm run ensure-dist && node scripts/ooxml-version-probe.mjs",
		"test:read": "pnpm run ensure-dist && vitest run test/read",
		"test:read:emit": "pnpm run ensure-dist && node scripts/read-emit-roundtrip.mjs",
		"test:read:emit:edits": "pnpm run ensure-dist && node scripts/read-emit-edits.mjs",
		"read:census": "pnpm run ensure-dist && node scripts/read-blindness-census.mjs",
		"read:append-ceiling": "pnpm run ensure-dist && node scripts/append-ceiling.mjs",
		"script:roundtrip": "pnpm run ensure-dist && node scripts/script-roundtrip.mjs",
		"test:watch": "vitest --watch test/regression",
		"test:coverage": "pnpm run ensure-dist && vitest run --coverage",
		"coverage:probe": "pnpm run ensure-dist && vitest run --coverage --coverage.reportsDirectory=coverage/probe --coverage.reporter=json --coverage.reporter=json-summary --coverage.reporter=text-summary --coverage.thresholds.statements=0 --coverage.thresholds.branches=0 --coverage.thresholds.functions=0 --coverage.thresholds.lines=0",
		"coverage:merge": "node scripts/coverage-merge.mjs",
		"coverage:gate": "pnpm run coverage:merge && node scripts/coverage-gate.mjs",
		"test:package": "node scripts/package-smoke.mjs",
		"test:browser": "pnpm run ensure-dist && pnpm run demos:build:vite && playwright test",
		"demos:build": "pnpm run ensure-dist && pnpm --dir demos/showcases run build",
		"demos:build:vite": "pnpm --dir demos/vite-demo run build",
		"test:com": "pnpm run ensure-dist && node scripts/powerpoint-com-smoke.mjs",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
		"typecheck:test": "tsc -p tsconfig.test.json --noEmit",
		"lint": "eslint . --no-warn-ignored",
		"lint:fix": "pnpm run lint --fix",
		"format:run": "prettier \"src/**/*.ts\" package.json pnpm-workspace.yaml typedoc.docs.json tsconfig*.json docs/tsconfig.json docs/.vitepress/config.mts eslint.config.mjs tsdown.config.ts tsdown.dev.config.ts vitest.config.ts playwright.config.ts \"scripts/**/*.mjs\" \"test/**/*.mjs\" \"test/**/*.js\" \".github/**/*.yml\"",
		"format": "pnpm run format:run --write",
		"format:check": "pnpm run format:run --check",
		"package:lint": "node scripts/package-lint.mjs",
		"backlog": "node scripts/backlog-ledger.mjs",
		"backlog:list": "node scripts/backlog-ledger.mjs list",
		"backlog:validate": "node scripts/backlog-ledger.mjs validate",
		"bundle-size:check": "pnpm run ensure-dist && node scripts/bundle-size-ratchet.mjs",
		"bundle-size:freeze": "pnpm run ensure-dist && node scripts/bundle-size-ratchet.mjs --freeze",
		"bundle-size:list": "pnpm run ensure-dist && node scripts/bundle-size-ratchet.mjs --list",
		"raw-xml:check": "node scripts/raw-xml-ratchet.mjs",
		"raw-xml:freeze": "node scripts/raw-xml-ratchet.mjs --freeze",
		"raw-xml:list": "node scripts/raw-xml-ratchet.mjs --list",
		"byte-identity:baseline": "node scripts/byte-identity.mjs baseline",
		"byte-identity:check": "node scripts/byte-identity.mjs check",
		"prepack": "pnpm run build",
		"check-validator": "node tools/ooxml-validator/check-updates.js",
		"docs:init": "node scripts/run-python.mjs scripts/docs-init.py",
		"docs:list": "node scripts/run-python.mjs scripts/docs-list.py",
		"docs:new": "node scripts/run-python.mjs scripts/docs-new.py",
		"docs:api": "node scripts/docs-api.mjs",
		"docs:llms": "node scripts/generate-llms-docs.mjs",
		"docs:index": "node scripts/run-python.mjs scripts/docs-index.py",
		"docs:check": "pnpm run docs:api && node scripts/run-python.mjs scripts/docs-check.py",
		"docs:prepare": "pnpm run docs:api && pnpm run docs:llms && pnpm run docs:index",
		"docs:dev": "pnpm run docs:prepare && vitepress dev docs",
		"docs:build": "pnpm run docs:prepare && node scripts/run-python.mjs scripts/docs-check.py && vitepress build docs",
		"docs:preview": "vitepress preview docs"
	},
	"dependencies": {
		"@xmldom/xmldom": "^0.9.10",
		"fflate": "^0.8.3",
		"opentype.js": "^2.0.0"
	},
	"peerDependencies": {
		"mathml2omml": "^0.5.0",
		"temml": "^0.13.3"
	},
	"peerDependenciesMeta": {
		"mathml2omml": {
			"optional": true
		},
		"temml": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@arethetypeswrong/core": "^0.18.5",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@types/node": "^26.1.1",
		"@types/opentype.js": "^1.3.10",
		"@typescript-eslint/eslint-plugin": "^8.64.0",
		"@typescript-eslint/parser": "^8.64.0",
		"@vitest/coverage-v8": "^4.1.10",
		"ast-v8-to-istanbul": "^1.0.5",
		"esbuild": "^0.28.1",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"fast-xml-parser": "^5.10.1",
		"happy-dom": "^20.11.1",
		"istanbul-lib-coverage": "^3.2.2",
		"istanbul-lib-report": "^3.0.1",
		"istanbul-reports": "^3.2.0",
		"jszip": "^3.10.1",
		"lefthook": "^2.1.10",
		"mathml2omml": "^0.5.0",
		"prettier": "^3.9.5",
		"publint": "^0.3.21",
		"temml": "^0.13.3",
		"tsdown": "^0.22.9",
		"tslib": "^2.8.1",
		"typedoc": "^0.28.20",
		"typedoc-plugin-markdown": "^4.12.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.64.0",
		"vitepress": "^1.6.4",
		"vitest": "^4.1.10",
		"yaml": "^2.9.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shbernal/ts-pptx.git"
	},
	"keywords": [
		"pptx",
		"ooxml",
		"powerpoint",
		"presentation",
		"slides",
		"typescript",
		"charts",
		"html"
	],
	"bugs": {
		"url": "https://github.com/shbernal/ts-pptx/issues"
	}
}
