{
	"$schema": "https://typedoc.org/schema.json",
	"entryPoints": [
		"src/index.ts",
		"src/node.ts",
		"src/browser.ts",
		"src/read.ts",
		"src/inspect.ts",
		"src/script.ts",
		"src/html.ts",
		"src/measure.ts",
		"src/math.ts",
		"src/zip.ts"
	],
	"entryPointStrategy": "resolve",
	"excludeInternal": true,
	"excludePrivate": true,
	"excludeProtected": true,
	"hideGenerator": true,
	"hidePageHeader": true,
	"hideBreadcrumbs": true,
	"disableSources": true,
	"parametersFormat": "table",
	"intentionallyNotExported": [
		"MediaBaseProps",
		"OleObjectBaseProps",
		"Model3dBaseProps",
		"BEVEL_PRESETS",
		"PRESET_MATERIALS",
		"LIGHT_RIGS",
		"LIGHT_RIG_DIRECTIONS",
		"RADAR_STYLES",
		"RADAR_STYLE_ALIASES",
		"EXTRA_SHAPE_PRESETS",
		"TextVerticalType",
		"THEME_COLOR_SLOTS",
		"COLOR_MAP_TOKENS",
		"EDGE_QNAMES",
		"ThemeContext",
		"TableCellStyleContext",
		"DrawingIndex",
		"EMBEDDED_FONT_SLOTS",
		"DECK_PROPS",
		"RunOpts"
	],
	"out": "docs/reference/api",
	"plugin": ["typedoc-plugin-markdown"],
	"readme": "none",
	"tsconfig": "tsconfig.json"
}
