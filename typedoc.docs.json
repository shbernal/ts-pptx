{
	"$schema": "https://typedoc.org/schema.json",
	"entryPoints": ["src/index.ts", "src/node.ts", "src/browser.ts"],
	"entryPointStrategy": "resolve",
	"excludeInternal": true,
	"excludePrivate": true,
	"excludeProtected": true,
	"hideGenerator": true,
	"intentionallyNotExported": [
		"MediaBaseProps",
		"OleObjectBaseProps",
		"Model3dBaseProps",
		"BEVEL_PRESETS",
		"PRESET_MATERIALS",
		"LIGHT_RIGS",
		"LIGHT_RIG_DIRECTIONS",
		"RADAR_STYLES",
		"RADAR_STYLE_ALIASES",
		"EXTRA_SHAPE_PRESETS",
		"TextVerticalType",
		"ExtractedSlides"
	],
	"out": "docs/reference/api",
	"plugin": ["typedoc-plugin-markdown"],
	"readme": "none",
	"tsconfig": "tsconfig.json"
}
