// oxlint configuration, replacing eslint.config.mjs. JSONC because most of what this
// file encodes is *why* — decisions that were measured once and should not be
// re-litigated. oxlint auto-discovers `.oxlintrc.jsonc` as well as `.oxlintrc.json`
// (verified against a control run with no config present).
//
// Every count below — finding totals, rule counts — is a point-in-time measurement,
// taken 2026-08-09 against oxlint 1.77.0 with oxlint-tsgolint 7.0.2001. They are the
// evidence the decisions rest on, not a description of the tree as it stands today;
// expect them to drift, and re-measure before treating any of them as current.
//
// ## The category baseline, and what it costs
//
// oxlint's default is `correctness` alone. That is deliberately kept, rather than the
// `correctness` + `suspicious` + `pedantic` that looks like the closer analogue of
// `eslint:recommended` + `recommendedTypeChecked`, because the wider baselines were
// measured on this tree: 17 findings at `correctness`, 753 adding `suspicious`, 1509
// adding `pedantic`. The extra 1492 are not latent bugs this repo had been missing —
// they are a different linter's house style, and several of them contradict decisions
// recorded below (`suspicious` turns `require-await` back on; `pedantic` wants
// `eqeqeq` across read/api). Adopting them would be a style migration wearing a
// toolchain swap's clothes.
//
// Parity is instead reached by naming rules explicitly. Of the 90 rules ESLint had
// enabled on `src/**/*.ts`, 57 are in oxlint's `correctness` already and 32 more are
// turned on by name in `rules` below. The 90th, `no-octal`, does not exist in oxlint
// and is not replaceable — see the note at the end of `rules`.
//
// The 17 `correctness` findings were real and were dealt with rather than silenced:
// one dead conjunct, three useless spread fallbacks, one redundant array copy and one
// regex-for-endsWith were fixed; one snapshot-before-mutation is suppressed inline at
// the site with its reason; and `unicorn/no-new-array` is off for the reason below.
{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	// Naming `plugins` *overwrites* oxlint's base set rather than adding to it, so the
	// three that are on by default (`unicorn`, `typescript`, `oxc`) have to be repeated
	// here or they silently switch off — every rule named in `rules` below is in one of
	// them. `eslint` is listed for symmetry; it is always on. The failure mode is silent
	// and worth stating once: with `["vitest"]` alone,
	// `typescript/no-floating-promises` stops firing and nothing reports that it has.
	//
	// `import` earns its place with a single rule: `import/no-duplicates`. The rest of
	// the plugin was measured before being let in — enabling it with no rules named
	// reports zero findings across this tree, so nothing else arrives with it.
	//
	// `vitest` was let in for one rule, `no-focused-tests`. A committed `.only` narrows
	// the whole suite to a single test and the gate still passes, which is a green CI
	// that ran almost nothing. It and `no-disabled-tests` both report zero on this tree,
	// so the guard was free to install.
	//
	// Three more of its rules are on since 2026-08-25, each configured rather than taken
	// bare — the counts that first argued for switching them off were counts of this
	// repo's own helpers, and every one of them has an option that names the helper. What
	// the remainder of the plugin costs is recorded in the `test/**` override below.
	"plugins": ["eslint", "unicorn", "typescript", "oxc", "import", "vitest"],
	"ignorePatterns": ["coverage/**", "demos/**", "dist/**", "node_modules/**", "src/bld/**", "types/**"],
	"categories": {
		"correctness": "error",
	},
	"rules": {
		// --- ESLint rules that `correctness` does not include, restored by name ---
		"eslint/no-case-declarations": "error",
		"eslint/no-empty": "error",
		"eslint/no-fallthrough": "error",
		"eslint/no-prototype-builtins": "error",
		"eslint/no-regex-spaces": "error",
		"eslint/no-useless-assignment": "error",
		"eslint/no-var": "error",
		"eslint/prefer-const": "error",
		"eslint/prefer-rest-params": "error",
		"eslint/prefer-spread": "error",
		"eslint/preserve-caught-error": "error",
		"typescript/ban-ts-comment": "error",
		"typescript/no-array-constructor": "error",
		"typescript/no-empty-object-type": "error",
		"typescript/no-explicit-any": "error",
		"typescript/no-namespace": "error",
		"typescript/no-require-imports": "error",
		"typescript/no-unnecessary-type-constraint": "error",
		"typescript/no-unsafe-function-type": "error",

		// Two imports of one module are two places to keep in sync when the specifier
		// moves, and they hide from a reader how much of a module a file actually
		// depends on. `preferInline` extends that to TypeScript: a value import and a
		// separate `import type` of the same module collapse to one statement with an
		// inline `type` qualifier. That spelling is safe under `verbatimModuleSyntax`
		// (which this tree compiles with), so the two-statement form buys nothing.
		"import/no-duplicates": ["error", { "preferInline": true }],

		// A cycle under `src/` is a runtime crash for a consumer, not a tidiness problem:
		// the second module in the cycle reads the first's bindings in their temporal dead
		// zone and throws at import time, in the consumer's app, with a message that names
		// neither file usefully. For a published library that is the worst place to find
		// out.
		"import/no-cycle": "error",
		"import/no-self-import": "error",

		// The other half of the guard: the specifier resolves but the *name* is not there.
		// oxlint has no `no-unresolved` — the rule simply does not exist in the plugin, so
		// asking for it fails the config rather than reporting zero — and these three are
		// what covers the same ground. They split by language, which is the point:
		// `default` fires on TypeScript, while `named` and `namespace` deliberately skip it
		// and fire on `.mjs`/`.js`, where `tsc` is not the gate that `src/**` gets.
		//
		// `named` has one known blind spot, suppressed inline at its single site: it cannot
		// follow a re-export through a CJS shim (`@playwright/test`, whose entry is
		// `module.exports = require('playwright/test')`) and calls an exported name missing.
		// One site is worth the suppression. If a second and third arrive, the rule is not
		// earning its noise in the JS lane and should come off with that recorded here.
		//
		// An import of a package that does not exist at all is *not* caught here; it
		// surfaces as `no-unsafe-*` on an error-typed value from tsgolint, which is enough.
		"import/named": "error",
		"import/default": "error",
		"import/namespace": "error",

		// All five report zero on this tree (2026-08-25), so they cost nothing to install
		// and only ever fire on something new. Every one was checked against a planted
		// violation rather than trusted at zero, because an import rule that resolves
		// nothing reports zero in exactly the same way and the two are indistinguishable
		// from the output. `import/export` is absent for precisely that reason: it is the
		// one in this family that did *not* fire on a planted duplicate export.
		//
		// The `promise` and `node` plugins are absent from `plugins` above for a reason
		// worth recording, so nobody spends the round trip finding it out again: neither
		// has a single rule in the `correctness` category, so at this config's baseline
		// turning either on adds no rule at all. Probed directly, not inferred.

		// --- type-aware, and the reason `options.typeAware` is on below ---
		// These are where `recommendedTypeChecked` was doing work that no syntax-only
		// linter can replicate. They need tsgolint (the Go typechecker oxlint shells
		// out to), which is why `oxlint-tsgolint` is a devDependency.
		"typescript/no-misused-promises": "error",
		"typescript/no-unsafe-argument": "error",
		"typescript/no-unsafe-assignment": "error",
		"typescript/no-unsafe-call": "error",
		"typescript/no-unsafe-enum-comparison": "error",
		"typescript/no-unsafe-member-access": "error",
		"typescript/no-unsafe-return": "error",
		"typescript/only-throw-error": "error",
		"typescript/prefer-promise-reject-errors": "error",
		"typescript/restrict-plus-operands": "error",

		// Not part of `recommendedTypeChecked` and not in any oxlint category this config
		// enables, so it is named here on its own. It reports *uses* of anything carrying a
		// JSDoc `@deprecated` tag, reaching through `.d.ts` into dependencies — which is the
		// half worth having: our own deprecations are visible in review, a dependency's are
		// not, and they are how a major-version break announces itself a release early.
		// Cost when turned on: zero findings in `src/**`, four across `test/**` and
		// `scripts/**`, all fixed in the same commit. Left on for `scripts/**` and `test/**`
		// deliberately — those overrides drop the `no-unsafe-*` family, whose findings are
		// `any` at an I/O boundary, but a deprecated call is the same defect wherever it is.
		"typescript/no-deprecated": "error",

		// Also outside `recommendedTypeChecked` and outside every enabled category. It
		// catches a `void` expression used where a *value* is read — the type means "there
		// is nothing here to look at", so reading one is either a mistake or a claim the
		// code does not honour. Both options are on, and both were measured (2026-08-25,
		// oxlint 1.79.0 / oxlint-tsgolint 7.0.2001) rather than assumed:
		//
		// `ignoreArrowShorthand` is the whole difference between a usable rule and an
		// unusable one here. Bare, the rule reports 36 findings; with it, 14. All 22 it
		// removes — and every one of the 13 that fell in `src/**` and `scripts/**` — are
		// `forEach((x) => fn(x))` and `new Promise((resolve) => ... resolve(v))`, where the
		// shorthand carries no ambiguity to resolve. Bracing them would be churn spelling
		// out what the reader already knows.
		//
		// `ignoreVoidOperator` sanctions `void expr` as a deliberate discard, which is a
		// spelling this tree already uses (`return void value.forEach(rename)` in
		// `test/read/script-roundtrip.test.js`). Without it the rule would be reporting the
		// marker whose entire job is to say the discard was on purpose. It also redirects
		// the autofix to that form instead of splitting the statement.
		//
		// Cost with both on: 13 findings, all one idiom — `if (!path) return expect(true)
		// .toBe(true)` as a fixture-missing skip guard — all fixed in the same commit. Left
		// on for `test/**` and `scripts/**` for the reason the block above gives.
		"typescript/no-confusing-void-expression": ["error", { "ignoreArrowShorthand": true, "ignoreVoidOperator": true }],

		// A third rule outside `recommendedTypeChecked` and outside every enabled
		// category: this one is `pedantic`, so it exists here only by name. Measured at
		// all four of its options (2026-08-25, oxlint 1.79.0 / oxlint-tsgolint 7.0.2001,
		// over `src/**`, `test/**` and `scripts/**`) so the choice does not get re-opened:
		// `in-try-catch` and `never` report 13 apiece, `always` reports 108, and the
		// option taken reports zero.
		//
		// That `in-try-catch` and `never` agree is the result worth keeping: `src/**` has
		// no `return` inside a `try` at all, so all 13 are a *redundant* `return await`
		// outside one — `writePackage`, `zip.generate`, the `FileReader`/`Image` promise
		// wrappers, `Presentation.write`. Not one is a missing await dropping a rejection
		// past a local `catch`, which is the only defect this rule is worth having for.
		// The awaits those two options would delete are not dead weight either: outside a
		// `try` the cost is one microtask, and V8 keeps the awaiting frame in the async
		// stack trace where `return promise` elides it. For a library whose failure mode
		// is "which part of assemble threw", that frame earns its tick.
		//
		// Hence `error-handling-correctness-only`. It reports nothing today, holds no
		// opinion on the 13, and fires only when a future `return somePromise` inside a
		// `try`/`catch`/`finally` would route the rejection past the handler standing
		// right there. Same bargain as `no-misused-promises` above: a type-aware rule kept
		// because it catches a bug, not because it has a house style.
		"typescript/return-await": ["error", "error-handling-correctness-only"],

		// Gate both compile-time escape hatches from the null-safety work: a bare `!`
		// and a provably-redundant `as` cast. Pinned together so the `!`/`as` symmetry
		// is explicit and survives any upstream preset change — the same reason they
		// were pinned under the previous linter.
		"typescript/no-non-null-assertion": "error",
		"typescript/no-unnecessary-type-assertion": "error",

		// The coercing numeric globals, banned so the sweep that removed them does not decay.
		// `isNaN` and `isFinite` coerce their argument first, which makes them answer a
		// different question from the one at the call site: `Number('') === 0`, so `isNaN('')`
		// is false and an empty string reads as a valid zero, and `isNaN(Infinity)` is false
		// too, so a value with no finite representation passes a "is this a number" guard and
		// reaches an attribute as `val="Infinity"`. Both had happened here. `Number.isFinite`
		// is the test nearly every site wants; `Number.isNaN` is for the few that clamp an
		// infinity on purpose rather than rejecting it.
		//
		// Scoped to `src/**` in `overrides` below rather than named globally, because the
		// scripts and the test suite are not the published package and pay a different price
		// for a coercion.
		"eslint/no-restricted-globals": "off",

		// Library output goes through `warn()` / `warnOnce()` so a consumer can route or
		// silence it (see diagnostics.ts), and failures go through the error classes. A
		// direct `console.*` is neither: it cannot be captured, muted, or branched on.
		// Three files are exempt in `overrides`; everything else that reaches for one
		// wants a diagnostic code or a thrown error instead.
		"eslint/no-console": "error",

		// --- type-aware rules measured and turned down, so they are not re-measured ---
		// All checked 2026-08-25 against oxlint 1.79.0 / oxlint-tsgolint 7.0.2001.
		//
		// `typescript/no-unnecessary-condition` reports 163 on `src/**`. It has the same
		// character as the `pedantic` sweep the header turns down: a house style about how
		// defensively to write a guard, not a set of latent bugs. Turning it on would mean
		// deleting 163 checks on the linter's word that the types make them impossible —
		// in a package whose whole job is parsing files other tools wrote.
		//
		// `no-unnecessary-boolean-literal-compare`, `no-unnecessary-template-expression`,
		// `no-misused-spread`, `no-array-delete` and `promise-function-async` each report
		// zero or one. Not turned on, because at those counts they are neither a gate nor
		// a cost and naming them only adds a line to keep true; recorded so the next
		// sweep can skip them rather than re-run them.
		//
		// `typescript/switch-exhaustiveness-check` reports 13 on `src/**` and is off. Its
		// history is worth keeping, because both the rule's own documentation and the
		// obvious reading of its options mislead here.
		//
		// The 13 are three populations and only one was ever a defect:
		//
		// - **Four switches over a closed enum with a silent `default`.** These were the
		//   argument for the rule, and they were fixed rather than guarded.
		//   `gen/slide/master.ts` and `gen/slide/object.ts` now spell out every member and
		//   close with `const unrouted: never = …`, so the *compiler* rejects an unrouted
		//   member on every build — a stronger gate than a linter, and the one to reach
		//   for first.
		//   `gen/chart/chart-xml.ts` and `gen/chart/chartex-xml.ts` partition `ChartType`
		//   between them, so neither can be exhaustive and neither can use `never`; they
		//   throw `InternalError('chart/type-not-routed')`, and the catalog sweep in
		//   `test/regression/chart/chart-option-validation.test.js` builds every
		//   `ChartType` member through `addChart`, so an unrouted member fails a test
		//   instead of shipping a chart-shaped hole. Probed both ways with a temporary
		//   enum member: each dispatcher's throw is what fails. Those two sites still
		//   *report*, because the rule counts a switch non-exhaustive however loud its
		//   default is.
		// - **Seven switches over an open string.** Six are on `Element.localName`, which
		//   `@xmldom/xmldom` types `string | null` (lib.dom's is `string`, so checking
		//   there will mislead); `src/units.ts` is the same shape off a regex `match[2]`.
		//   The rule reports only `null`/`undefined` as unmatched; `string` is not a
		//   closed union, so "exhaustive" is not a property these have, and a `default`
		//   returning null is the correct defensive shape for element names a real
		//   `.pptx` may carry. Three of the six have no `default` at all, deliberately.
		// - **Four in `script/from-read/**` whose `default` calls
		//   `notes.note(…, 'dropped', 'unsupported', …)`.** The default *is* the feature:
		//   a declared lossy conversion announcing what it could not carry. Widening one
		//   is a claim the conversion is no longer lossy — a different change.
		//
		// So turning it on means an override switching it off for `src/read/**`,
		// `src/script/from-read/**` and `src/units.ts`, plus two inline suppressions — a
		// standing exemption over two whole directories, bought to restate guards the
		// compiler and the test suite already hold. What that would still have covered, a
		// *new* closed-union switch outside those paths, is left to the `never` arm being
		// the house idiom for one. `considerDefaultExhaustiveForUnions: true` takes the
		// tree to zero on its own, by treating any default as exhaustive — every site here
		// has one, so it would guard nothing that exists.
		//
		// Not a branch: `defaultCaseCommentPattern` cannot annotate these. It is not a
		// no-op — it was broken, reported as `oxc#24338` and fixed by `tsgolint#1070`, and
		// the fix is in the `oxlint-tsgolint` 7.0.2001 pinned here — but what it does is
		// not what it looks like. Upstream the matching comment is a *substitute* for an
		// omitted `default`, read after the last case, and it only sets `defaultCase`;
		// suppressing a union also needs `considerDefaultExhaustiveForUnions`. A marker on
		// a live `default:` arm does nothing, in any of the four placements probed — and a
		// live `default:` is the shape at every site the rule was bought for. Worse, the
		// mechanism would mislead here: deleting a `default: return ''` and leaving a
		// marker satisfies the rule while the same silent empty string moves to a
		// `return ''` after the switch. The rule's oxlint docs advertise exactly that
		// shape (`default: // @skip-exhaustive-check`), describing a mechanism neither
		// linter implements; raised as `oxc#26087`.

		// --- rules intentionally relaxed for this codebase ---
		// Several async methods exist only to satisfy a uniform Promise-returning
		// contract (runtime adapters, zip/opc save, excel worksheet) even when a given
		// impl has no await.
		"typescript/require-await": "off",
		// Output paths deliberately coerce `unknown`/union values with
		// String()/.toString() while assembling OOXML strings; the object-stringification
		// guard is noise here.
		"typescript/no-base-to-string": "off",
		// Public color types are `literal-union | string` on purpose: the literals drive
		// editor autocomplete while `string` keeps an escape hatch for arbitrary hex.
		"typescript/no-redundant-type-constituents": "off",
		"eslint/no-lone-blocks": "off",
		// Every one of the ten sites this fires on is `new Array<T>(n).fill(v)`. The
		// rule's stated reason is that `new Array(x)` is ambiguous about whether `x` is
		// a length or a lone element; an explicit type argument followed by `.fill()`
		// removes that ambiguity, and the suggested `Array.from({ length: n })` is a
		// longer spelling of the same dense array. Off rather than churned.
		"unicorn/no-new-array": "off",

		// `eslint/no-octal` has no oxlint equivalent and needs none: legacy octal
		// literals are a syntax error in strict mode, every source file here is an ES
		// module, and modules are always strict. The parser rejects what the rule
		// forbids, so this is the one rule lost in the swap and it is lost harmlessly.
	},
	"overrides": [
		{
			// See `no-restricted-globals` in `rules` above for why these two are banned. The
			// override is where the rule is actually configured: `rules` can only turn it off
			// tree-wide, and the ban is meant for the published library rather than for
			// `scripts/**` and `test/**`.
			"files": ["src/**/*.ts"],
			"rules": {
				"eslint/no-restricted-globals": [
					"error",
					{
						"name": "isNaN",
						"message": "`isNaN` coerces: isNaN('') is false. Use Number.isNaN, or Number.isFinite if a non-finite value is also invalid.",
					},
					{
						"name": "isFinite",
						"message": "`isFinite` coerces: isFinite('1') is true. Use Number.isFinite.",
					},
				],
			},
		},
		{
			// The three exemptions to `no-console`, all deliberate.
			//
			// `diagnostics.ts` owns the default handler — the one `console.warn` every
			// diagnostic funnels into when the consumer has installed nothing else.
			//
			// The `verbose: true` table tracers are a different kind of output from a
			// diagnostic: a DEV-ONLY flag (see `TableProps.verbose`) that prints a
			// multi-line trace of the auto-paging arithmetic. Routing it through the
			// diagnostic handler would mean inventing a code per formatted line and
			// flooding a consumer's handler with output that reports no condition. A
			// consumer silences it by not passing the flag, so it is opt-in, not
			// unroutable.
			"files": ["src/diagnostics.ts", "src/gen/table/autopage.ts", "src/gen/table/html-dom.ts"],
			"rules": {
				"eslint/no-console": "off",
			},
		},
		{
			// Measured, so it does not get retried — but the measurement has moved once,
			// and the reason it moved is worth keeping.
			//
			// `scripts/**` does have a typechecked project (`tsconfig.scripts.json`,
			// `checkJs`), so type-aware rules are *available* here in a way they are not
			// for the root configs below. Under the previous linter, turning them on
			// reported 1849 errors, of which 1843 were the `no-unsafe-*` family, because
			// that project then set `noImplicitAny: false`: every unannotated parameter was
			// `any` and every member access on one "unsafe". Re-measured under oxlint with
			// the list below deleted: 13798 findings over `scripts/**` + `test/**` (1276 of
			// them in `scripts/**` alone), 99.7% of them that same family.
			//
			// `scripts/**` has since been annotated in JSDoc and `noImplicitAny` turned on
			// there, which was the cheaper half of the "migrate scripts/ to TypeScript"
			// question. Re-measured again on that tree: **289** findings in `scripts/**`,
			// down from 1276 — but 285 of the 289 are still `no-unsafe-*`. The residue is
			// not unannotated parameters any more; it is `JSON.parse` (which returns `any`
			// by definition) and the handful of untyped modules these scripts import. So
			// the rules stay off, for a different reason than before: what they now report
			// is the `any` at an I/O boundary, which an annotation cannot remove and
			// `tsc -p tsconfig.scripts.json` already understands. That is the type gate for
			// this tree. `test/**` is unannotated and unmeasured since; it is the larger
			// share of the 13798 and would have to be paid separately.
			// The list below is every type-aware rule this config leaves enabled, minus
			// `no-floating-promises` and `no-misused-promises`. Those two are the pair the
			// old measurement called out as the ones actually worth having, they report
			// zero here, and oxlint — unlike the preset-based setup this replaces — lets
			// them stay on without dragging the `no-unsafe-*` family along. Keeping them is
			// the one place this swap tightens the gate rather than reproducing it.
			"files": ["scripts/**/*.mjs", "test/**/*.mjs", "test/**/*.js"],
			"env": {
				"node": true,
				"es2024": true,
			},
			"rules": {
				"eslint/no-console": "off",
				"typescript/no-explicit-any": "off",
				"typescript/await-thenable": "off",
				"typescript/no-array-delete": "off",
				"typescript/no-duplicate-type-constituents": "off",
				"typescript/no-for-in-array": "off",
				"typescript/no-implied-eval": "off",
				"typescript/no-meaningless-void-operator": "off",
				"typescript/no-misused-spread": "off",
				"typescript/no-unnecessary-type-assertion": "off",
				"typescript/no-unsafe-argument": "off",
				"typescript/no-unsafe-assignment": "off",
				"typescript/no-unsafe-call": "off",
				"typescript/no-unsafe-enum-comparison": "off",
				"typescript/no-unsafe-member-access": "off",
				"typescript/no-unsafe-return": "off",
				"typescript/no-unsafe-unary-minus": "off",
				"typescript/no-useless-default-assignment": "off",
				"typescript/only-throw-error": "off",
				"typescript/prefer-promise-reject-errors": "off",
				"typescript/prefer-string-starts-ends-with": "off",
				"typescript/require-array-sort-compare": "off",
				"typescript/restrict-plus-operands": "off",
				"typescript/restrict-template-expressions": "off",
				"typescript/unbound-method": "off",

				// Three vitest rules that were first measured bare, judged by their counts, and
				// switched off. Re-measured on 2026-08-25 with their options set, which is what
				// the counts were really asking for: every one of them was describing a helper
				// this repo wrote, and every one of them takes an option that names it. All
				// three report zero configured this way, so what was silence is now a live gate.
				// Counts below are bare-then-configured (oxlint 1.79.0).
				//
				// `expect-expect` (447 -> 0). The whole regression tier asserts through
				// `assert`/`assertIncludes` rather than `expect`, so the rule saw a test body
				// with no `expect` in it and called the test assertion-free. It was describing
				// the helper. The list is what actually asserts here, and each entry is a
				// category rather than a one-off site:
				//   `expect*`   — `expect` plus `expectKind`, which wraps it.
				//   `assert*`   — the `assert`/`assertEqual`/`assertXmlOrder`… family in
				//                 `test/helpers.js`. `throws` is deliberately *not* listed: it
				//                 returns a boolean instead of throwing, so it is only ever an
				//                 argument to `assert` and listing it would sanction a bare
				//                 `throws(…)` statement that asserts nothing.
				//   `near`      — the tolerance comparison in the import-shape/import-slide
				//                 suites; a local arrow, but it wraps `assert`.
				//   `ctx.skip`  — a test that skips itself has nothing left to assert. That is
				//                 a shape, not an omission.
				//   `fixture.fn`— the same driver indirection `no-standalone-expect` needs
				//                 below: the assertions are in the case object, one call away.
				//
				// `no-standalone-expect` (6 -> 0) could not see through `defineRegressionSuite`
				// — the expects sit in a case object's `fn` and the `it()` wrapping them is
				// created by the driver a file away. `additionalTestBlockFunctions` is the
				// supported way to tell it about a driver. Checked against a planted
				// `expect()` at module scope, which still reports.
				//
				// `valid-expect` (5 -> 0) rejects `expect(value, message)` unless the message
				// is a string or template *literal*; all five sites build the message from
				// fixture data. Not oxlint's own opinion: it is a faithful port of
				// eslint-plugin-vitest, whose source carries the comment "2nd argument should
				// be string, not a variable in current implementation" next to the same check
				// (and `oxc#18851` -> `oxc#18975` is where the literal case was allowed).
				// `maxArgs: 2` is that plugin's own documented escape hatch. It keeps
				// everything else the rule does: three arguments, a matcher never called and
				// an unawaited async assertion all still report, checked by planting each.
				"vitest/expect-expect": [
					"error",
					{ "assertFunctionNames": ["expect*", "assert*", "near", "ctx.skip", "fixture.fn"] },
				],
				"vitest/no-standalone-expect": ["error", { "additionalTestBlockFunctions": ["defineRegressionSuite"] }],
				"vitest/valid-expect": ["error", { "maxArgs": 2 }],

				// The four that stay off. These are the oracle tests, which branch on what a
				// fixture supports and build their titles out of fixture data — a shape no
				// option reaches, unlike the four above. `no-conditional-expect` (17),
				// `valid-title` (7), `no-conditional-tests` (2), `warn-todo` (1).
				"vitest/no-conditional-expect": "off",
				"vitest/valid-title": "off",
				"vitest/no-conditional-tests": "off",
				"vitest/warn-todo": "off",
			},
		},
		{
			// The browser lane is the one place under `test/` whose code runs in a page,
			// and the two halves of it need different amounts of DOM.
			//
			// A **spec** is ordinary Node except for its `page.evaluate` callbacks, which
			// are serialized and evaluated in the page. Those reach `window` and nothing
			// else here grants more, deliberately: a reference to `document` or `fetch`
			// outside an evaluate callback would be a mistake worth catching.
			"files": ["test/browser/**/*.mjs"],
			"globals": {
				"window": "readonly",
			},
		},
		{
			// A **harness module** is page code outright — loaded by its own document
			// over a `<script type="module">`, never imported by Node. Reading the DOM is
			// its whole job (`table.mjs` renders a fixture and measures it), so
			// withholding `document` there would only mean writing the same access in a
			// form the linter cannot see.
			//
			// Kept to this directory rather than folded into the block above so the
			// distinction survives: the specs still cannot touch the DOM outside an
			// evaluate callback.
			"files": ["test/browser/harness/**/*.mjs"],
			"globals": {
				"document": "readonly",
				"getComputedStyle": "readonly",
				"window": "readonly",
			},
		},
		{
			// The root build configs matched no block at all under the previous linter,
			// so zero rules applied to them. Untyped only: these are a handful of
			// declarative config objects, and type-aware rules would mean building a
			// program for them.
			"files": ["*.config.ts", "*.config.mts"],
			"env": {
				"node": true,
				"es2024": true,
			},
			"rules": {
				"typescript/await-thenable": "off",
				"typescript/no-array-delete": "off",
				"typescript/no-duplicate-type-constituents": "off",
				"typescript/no-for-in-array": "off",
				"typescript/no-implied-eval": "off",
				"typescript/no-meaningless-void-operator": "off",
				"typescript/no-misused-spread": "off",
				"typescript/no-unnecessary-type-assertion": "off",
				"typescript/no-unsafe-argument": "off",
				"typescript/no-unsafe-assignment": "off",
				"typescript/no-unsafe-call": "off",
				"typescript/no-unsafe-enum-comparison": "off",
				"typescript/no-unsafe-member-access": "off",
				"typescript/no-unsafe-return": "off",
				"typescript/no-unsafe-unary-minus": "off",
				"typescript/no-useless-default-assignment": "off",
				"typescript/only-throw-error": "off",
				"typescript/prefer-promise-reject-errors": "off",
				"typescript/prefer-string-starts-ends-with": "off",
				"typescript/require-array-sort-compare": "off",
				"typescript/restrict-plus-operands": "off",
				"typescript/restrict-template-expressions": "off",
				"typescript/unbound-method": "off",
			},
		},
	],
	"options": {
		// Type-aware rules are the half of the old `recommendedTypeChecked` that a
		// syntax-only pass cannot reach. Enabled in config rather than by a CLI flag so
		// an editor's oxlint integration gets the same answer as `pnpm run lint`.
		"typeAware": true,
	},
}
